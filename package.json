{
  "name": "tolihair",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "supabase:check": "node --env-file=.env scripts/check-supabase.mjs",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "db:verify": "node --env-file=.env scripts/db-verify.mjs",
    "db:sync-barber-services": "node --env-file=.env scripts/sync-barber-services.mjs",
    "db:test": "node scripts/test-db.mjs",
    "test:management:db": "node scripts/test-management-db.mjs",
    "test:booking:db": "node scripts/test-booking-db.mjs",
    "test:appointments:db": "node scripts/test-appointments-db.mjs",
    "test:auth": "node --test tests/auth-policy.test.mjs && node tests/auth.integration.mjs",
    "test:unit": "node --test tests/money.test.mjs tests/booking-client.test.mjs",
    "check:release-env": "node --env-file=.env scripts/check-release-env.mjs",
    "verify:release": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:auth"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.10.0",
    "pg": "^8.23.0",
    "supabase": "^2.117.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
