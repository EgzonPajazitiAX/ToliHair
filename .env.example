# Supabase public connection (the existing .env names are supported).
SUPABASE_URL=
SUPABASE_KEY=
# Required by the Phase 6 server for guest appointment creation and receipts.
SUPABASE_SECRET_KEY=
# PostgreSQL connection string from Supabase > Connect. Required for migrations.
# Keep special characters in its password URL-encoded; never put it in public config.
SUPABASE_DB_URL=
# Public-facing origin used for CSRF checks behind an HTTPS reverse proxy.
# Required in production. Use only the HTTPS origin, without a trailing path.
APP_ORIGIN=https://your-domain.example
# Nuxt-native names below are the recommended runtime variables for deployment
# and Docker. Set them in the hosting platform; local development may use the
# shorter equivalents above.
NUXT_PUBLIC_SITE_NAME=Toli Hair
# Uncomment only when using Nuxt-native overrides instead of the names above.
# NUXT_PUBLIC_SUPABASE_URL=
# NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Private server credential. Never use a NUXT_PUBLIC_ prefix for this key.
# NUXT_SUPABASE_SECRET_KEY=
